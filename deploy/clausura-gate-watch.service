[Unit]
Description=Penca Clausura — vigía del gate del penca-api (ventanas de visibilidad)
After=network-online.target
Wants=network-online.target
OnFailure=penca-failure-notify@%n.service

[Service]
Type=oneshot
EnvironmentFile=/etc/penca/env
Environment="PYTHONPATH=/opt/penca"
WorkingDirectory=/opt/penca
ExecStart=/opt/penca/.venv/bin/python -m src.clausura.gate_watch
StandardOutput=append:/var/lib/penca/logs/clausura-gate-watch.log
StandardError=append:/var/lib/penca/logs/clausura-gate-watch.err
User=root
