[Unit]
Description=Penca Clausura — auditoría anti-drift (web vs planilla guardada)
After=network-online.target
Wants=network-online.target
OnFailure=penca-failure-notify@%n.service

[Service]
Type=oneshot
EnvironmentFile=/etc/penca/env
Environment="PYTHONPATH=/opt/penca"
WorkingDirectory=/opt/penca
ExecStart=/opt/penca/.venv/bin/python -m src.clausura.drift_audit --if-started
StandardOutput=append:/var/lib/penca/logs/clausura-drift-audit.log
StandardError=append:/var/lib/penca/logs/clausura-drift-audit.err
User=root
