[Unit]
Description=Timer del pipeline de picks del Clausura — diario 11:00 UTC (08:00 UY)

# Jueves: primera pasada con odds recién publicadas (aparecen 24-48h antes).
# Vie/sáb/dom/lun: refresh la mañana de cada día de partido.
# DIARIO (antes jue-lun): un suspendido re-programado entre semana (pasó con
# Torque-Peñarol de la F1) caía martes o miércoles SIN pasada de la mañana —
# ni planilla ni Telegram para el único partido del día. La corrida de un día
# sin partidos cerca es barata (~6 min) y sale en silencio relativo.
#
# 11:00 UTC: el build con 2400 sims tarda ~15 min MEDIDOS en el droplet (la
# corrida real del 6/8: 09:05→09:19), no los ~100 que estimé de más. Con el
# cierre más temprano del fixture a las 13:45 UTC quedan 2h30 de margen, y
# corriendo más tarde el mercado está más maduro. Planilla ~08:15 UY.
# Backtest 2026-08-06: 2400 sims vs 800 = +$14k E[premio] (winner's curse en las
# decisiones del ascenso por coordenadas; test pareado por semilla).
# La planilla llega por Telegram; la carga en la web sigue siendo manual.

[Timer]
OnCalendar=*-*-* 11:00:00 UTC
Persistent=true
RandomizedDelaySec=300

[Install]
WantedBy=timers.target
