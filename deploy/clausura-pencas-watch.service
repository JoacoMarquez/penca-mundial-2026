[Unit]
Description=Penca — aviso cuando Supermatch publica una penca nueva
After=network-online.target
Wants=network-online.target
OnFailure=penca-failure-notify@%n.service

[Service]
Type=oneshot
EnvironmentFile=/etc/penca/env
Environment="PYTHONPATH=/opt/penca"
WorkingDirectory=/opt/penca
ExecStart=/opt/penca/.venv/bin/python -m src.clausura.pencas_watch
StandardOutput=append:/var/lib/penca/logs/clausura-pencas-watch.log
StandardError=append:/var/lib/penca/logs/clausura-pencas-watch.err
User=root
