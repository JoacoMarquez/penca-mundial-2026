[Unit]
Description=Penca LUB — recordatorio de carga a 6h y 2h de cada cierre
After=network-online.target
Wants=network-online.target
OnFailure=penca-failure-notify@%n.service

[Service]
Type=oneshot
EnvironmentFile=/etc/penca/env
Environment="PYTHONPATH=/opt/penca"
WorkingDirectory=/opt/penca
ExecStart=/opt/penca/.venv/bin/python -m src.lub.carga_alert
StandardOutput=append:/var/lib/penca/logs/lub-carga-alert.log
StandardError=append:/var/lib/penca/logs/lub-carga-alert.err
User=root
