[Unit]
Description=Penca Clausura 2026 — pipeline de picks (fecha auto) + planilla por Telegram
After=network-online.target
Wants=network-online.target
OnFailure=penca-failure-notify@%n.service

[Service]
Type=oneshot
EnvironmentFile=/etc/penca/env
Environment="PYTHONPATH=/opt/penca"
WorkingDirectory=/opt/penca
ExecStartPre=/opt/penca/.venv/bin/python -m src.clausura.sync
# "-": si Wikipedia falla, el pipeline sigue con el intermedio ya guardado
ExecStartPre=-/opt/penca/.venv/bin/python -m src.clausura.intermedio
# Escaneo del pool de la mañana: es LA pasada del día (los timers de abajo reusan
# esta vía --max-edad-h). --reusar-especiales evita re-pedir campeón/goleador, que
# post-lock ya no cambian: la mitad de los ~1.370 requests.
# "-": si el API nos limita, el escaneo aborta sin guardar y el pipeline
# sigue con el snapshot previo — mejor eso que no emitir planilla.
ExecStartPre=-/opt/penca/.venv/bin/python -m src.clausura.pool_snapshot --if-started --reusar-especiales --max-edad-h 6
# --sims: el ascenso por coordenadas compara dos estimaciones Monte Carlo, así que
# con pocos sorteos elige ruido. Medido out-of-sample con sorteos comunes:
#     2.400 → 9.600   +$21.060 ± 936
#     9.600 → 19.200  +$1.452 ± 401  (4/4 semillas, RÉGIMEN DE PRODUCCIÓN)
#
# Ojo con el segundo número: la auditoría del 8/8 decía +$6.461 ± 609, pero eso salió
# de DOS semillas y de un pool sintético i.i.d. Con 715 rivales correlacionados la
# cola del máximo es más gorda, y reducir el ruido de MEDICIÓN rinde menos cuando la
# incertidumbre estructural sube. El sintético sobreestima, y en dirección predecible.
#
# El techo era la MEMORIA del droplet. Tres reducciones (compactar rivals_fecha,
# trocear _tilted_sample por rivales, int16 en los picks) bajaron el pico de 620 a
# 548 MB, y el 2026-08-10 el droplet pasó de 1 a 2 GB. Pico medido allá:
#     S=9600 → 360 MB · S=19200 → 548 MB, sobre ~1.900 MB   (28% de uso)
# Tiempo: ~11 min de optimización + ~9 de escaneo, contra una ventana de 2h45 hasta
# el primer cierre.
#
# No subir más sin volver a medir acá: la curva satura (21k → 1,4k por duplicación) y
# el próximo escalón difícilmente pague.
ExecStart=/opt/penca/.venv/bin/python -m src.clausura.picks --fecha auto --telegram --participaciones 12 --sims 19200
StandardOutput=append:/var/lib/penca/logs/clausura-picks.log
StandardError=append:/var/lib/penca/logs/clausura-picks.err
User=root
