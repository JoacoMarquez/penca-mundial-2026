[Unit]
Description=Penca Clausura — alerta si faltan cargar picks cerca del cierre
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
EnvironmentFile=/etc/penca/env
Environment="PYTHONPATH=/opt/penca"
WorkingDirectory=/opt/penca
ExecStart=/opt/penca/.venv/bin/python -m src.clausura.carga_alert
StandardOutput=append:/var/lib/penca/logs/clausura-carga-alert.log
StandardError=append:/var/lib/penca/logs/clausura-carga-alert.err
User=root
