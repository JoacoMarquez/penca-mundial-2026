[Unit]
Description=Timer de alertas de carga del Clausura — cada hora en la ventana de cierres

# Los cierres reales caen 17:45-22:45 UTC; con el aviso de 6h la ventana útil
# arranca ~11:45 UTC. Fuera de días de partido el script sale en silencio.

[Timer]
OnCalendar=*-*-* 11..23:10:00 UTC
Persistent=false

[Install]
WantedBy=timers.target
