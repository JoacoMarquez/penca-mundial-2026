[Unit]
Description=Valuebet — settlement de sugerencias terminadas
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
EnvironmentFile=/etc/penca/env
EnvironmentFile=-/etc/penca/valuebet-env
Environment="PYTHONPATH=/opt/penca"
WorkingDirectory=/opt/penca
ExecStart=/opt/penca/.venv/bin/python -m src.valuebet.runner settle
User=root
