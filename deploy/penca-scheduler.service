[Unit]
Description=Penca Mundial 2026 scheduler — chequea fixtures cada 5 min y dispara la pipeline en T-24h/T-3h/T-30min
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
EnvironmentFile=/etc/penca/env
Environment="PYTHONPATH=/opt/penca"
WorkingDirectory=/opt/penca
ExecStart=/opt/penca/.venv/bin/python -m src.agent.scheduler
StandardOutput=append:/var/lib/penca/logs/scheduler.log
StandardError=append:/var/lib/penca/logs/scheduler.err
# El usuario root es overkill pero simplifica permisos para Playwright
User=root
