[Unit]
Description=Penca LUB — aviso cuando aparecen los menús de Goleador/Campeón
After=network-online.target
Wants=network-online.target
OnFailure=penca-failure-notify@%n.service

[Service]
Type=oneshot
EnvironmentFile=/etc/penca/env
Environment="PYTHONPATH=/opt/penca"
WorkingDirectory=/opt/penca
ExecStart=/opt/penca/.venv/bin/python -m src.lub.goleador_watch
StandardOutput=append:/var/lib/penca/logs/lub-goleador-watch.log
StandardError=append:/var/lib/penca/logs/lub-goleador-watch.err
User=root
