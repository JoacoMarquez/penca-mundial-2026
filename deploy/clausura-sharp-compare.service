[Unit]
Description=Penca Clausura — cuotas Pinnacle vs Supermatch de la Primera (historial persistente)
After=network-online.target
Wants=network-online.target
OnFailure=penca-failure-notify@%n.service

[Service]
Type=oneshot
EnvironmentFile=/etc/penca/env
Environment="PYTHONPATH=/opt/penca"
WorkingDirectory=/opt/penca
ExecStart=/opt/penca/.venv/bin/python -m scripts.odds_sharp_vs_supermatch
StandardOutput=append:/var/lib/penca/logs/clausura-sharp-compare.log
StandardError=append:/var/lib/penca/logs/clausura-sharp-compare.err
User=root
