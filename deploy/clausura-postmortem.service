[Unit]
Description=Penca Clausura — postmortem automático al completarse una fecha
After=network-online.target
Wants=network-online.target
OnFailure=penca-failure-notify@%n.service

[Service]
Type=oneshot
EnvironmentFile=/etc/penca/env
Environment="PYTHONPATH=/opt/penca"
WorkingDirectory=/opt/penca
# snapshot fresco del pool: los picks quedan lockeados al cierre, así el postmortem
# compara contra el pool completo y no contra el snapshot del mediodía
# 3h (no 6): a las 03:20 el postmortem necesita el pool DESPUÉS del último partido
# del día, y el escaneo de la tarde ya quedó viejo.
# "-": si el API nos limita, el escaneo aborta sin guardar y el pipeline
# sigue con el snapshot previo — mejor eso que no emitir planilla.
ExecStartPre=-/opt/penca/.venv/bin/python -m src.clausura.pool_snapshot --if-started --reusar-especiales --max-edad-h 3
ExecStart=/opt/penca/.venv/bin/python -m src.clausura.postmortem
StandardOutput=append:/var/lib/penca/logs/clausura-postmortem.log
StandardError=append:/var/lib/penca/logs/clausura-postmortem.err
User=root
