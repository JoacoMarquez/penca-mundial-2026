[Unit]
Description=Penca Clausura — aviso cuando aparecen los menús de Campeón/Goleador
After=network-online.target
Wants=network-online.target
OnFailure=penca-failure-notify@%n.service

[Service]
Type=oneshot
EnvironmentFile=/etc/penca/env
Environment="PYTHONPATH=/opt/penca"
WorkingDirectory=/opt/penca
ExecStart=/opt/penca/.venv/bin/python -m src.clausura.goleador_watch
StandardOutput=append:/var/lib/penca/logs/clausura-goleador-watch.log
StandardError=append:/var/lib/penca/logs/clausura-goleador-watch.err
User=root
