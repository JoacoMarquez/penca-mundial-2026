[Unit]
Description=Penca Clausura — corrida extra ~2h antes del primer cierre del día (diff vs planilla)
After=network-online.target
Wants=network-online.target
OnFailure=penca-failure-notify@%n.service

[Service]
Type=oneshot
# El tick de las 11:35 sale 12 min después de que suele terminar la corrida diaria
# (11:00 + ~20 min), y no hay exclusión mutua entre las dos: si un día la diaria se
# demora, arrancarían dos pipelines de 19.200 sorteos a la vez en un droplet de 2 GB
# —compitiendo por CPU— y encima este rerun diffearía contra la planilla de AYER.
# ExecCondition saltea el tick LIMPIAMENTE (no cuenta como falla, no dispara el
# OnFailure a Telegram); el cierre queda sin cubrir en el estado, así que el tick
# siguiente lo reintenta solo.
ExecCondition=/bin/sh -c '! systemctl is-active --quiet clausura-picks.service'
EnvironmentFile=/etc/penca/env
Environment="PYTHONPATH=/opt/penca"
WorkingDirectory=/opt/penca
ExecStartPre=/opt/penca/.venv/bin/python -m src.clausura.sync
# Este timer dispara CADA HORA (12:35-21:35): sin --max-edad-h eran ~1.370 requests
# por hora = 429 asegurado. Con 6h reusa el escaneo de la mañana y solo re-escanea
# una vez a media tarde, que es cuando ya cerraron partidos nuevos.
# "-": si el API nos limita, el escaneo aborta sin guardar y el pipeline
# sigue con el snapshot previo — mejor eso que no emitir planilla.
ExecStartPre=-/opt/penca/.venv/bin/python -m src.clausura.pool_snapshot --if-started --reusar-especiales --max-edad-h 6
# SIN --sims a propósito: el rerun hereda las sims de la planilla contra la que
# diffea. Correr con otro número no es "más rápido", es INVÁLIDO — el ascenso por
# coordenadas cae en otro óptimo local y el diff deja de significar "se movieron
# los insumos". Medido el 8/8 con 1600 acá y 2400 en la pasada principal: 56 de 96
# picks reasignados con insumos idénticos, y E[premio] out-of-sample $238k → $221k.
# Tiempos reales en el droplet a las sims de PRODUCCIÓN (medido 2026-08-12, con
# el cache del premio por fecha): 19.200 sims = 33m36s TOTAL, incluida la
# evaluación del gate (5 semillas, ~22 min). Contra la ventana de ~70 min desde
# el disparo (T-2.5h) hasta el primer cierre: el aviso llega con ~36 min de
# margen para recargar. Entra. Si se suben las sims o las semillas, RE-MEDIR:
# la versión anterior de este comentario decía "Entra" medido a 2.400 y quedó
# 4 días vencida sin que nadie lo note.
ExecStart=/opt/penca/.venv/bin/python -m src.clausura.rerun_cierre --participaciones 12
# Para ver el pico real: el aviso por valor construye un simulador por semilla de
# evaluación (351 MB medidos a 2400 sims × 684 rivales) encima de la optimización,
# en un droplet de 1 GB. Sin accounting, un OOM aparecería como "no llegó el aviso".
MemoryAccounting=yes
StandardOutput=append:/var/lib/penca/logs/clausura-rerun-cierre.log
StandardError=append:/var/lib/penca/logs/clausura-rerun-cierre.err
User=root
