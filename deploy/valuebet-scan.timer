[Unit]
# Horario: el edge en un soft book lento aparece y desaparece en horas — 3 pasadas/día
# perdía casi todas las ventanas. Costo por scan: 1 POST a Supermatch + 2 GETs a
# Pinnacle por deporte. Al minuto :05 para no colisionar con el close (:00/:30);
# el flock del ledger cubre igual cualquier solapamiento.
Description=Valuebet scan — horario, al minuto :05
Requires=valuebet-scan.service

[Timer]
OnCalendar=*-*-* *:05:00
Persistent=true
AccuracySec=1min

[Install]
WantedBy=timers.target
