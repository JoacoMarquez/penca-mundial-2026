[Unit]
Description=Valuebet — captura de closing lines (CLV) de sugerencias próximas
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
EnvironmentFile=/etc/penca/env
EnvironmentFile=-/etc/penca/valuebet-env
Environment="PYTHONPATH=/opt/penca"
WorkingDirectory=/opt/penca
ExecStart=/usr/bin/flock -w 600 /opt/penca/data/valuebet/.ledger.lock /opt/penca/.venv/bin/python -m src.valuebet.runner close
User=root
