[Unit]
Description=Penca LUB — aviso de cuotas publicadas, no matcheadas y mercado de campeón
After=network-online.target
Wants=network-online.target
OnFailure=penca-failure-notify@%n.service

[Service]
Type=oneshot
EnvironmentFile=/etc/penca/env
Environment="PYTHONPATH=/opt/penca"
WorkingDirectory=/opt/penca
ExecStart=/opt/penca/.venv/bin/python -m src.lub.cuotas_watch
StandardOutput=append:/var/lib/penca/logs/lub-cuotas-watch.log
StandardError=append:/var/lib/penca/logs/lub-cuotas-watch.err
User=root
