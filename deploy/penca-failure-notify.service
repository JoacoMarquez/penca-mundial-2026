[Unit]
Description=Penca — notificar a Telegram cuando otro service falla

[Service]
Type=oneshot
EnvironmentFile=/etc/penca/env
Environment="PYTHONPATH=/opt/penca"
WorkingDirectory=/opt/penca
ExecStart=/opt/penca/.venv/bin/python -c "from src.notifier.telegram import TelegramNotifier, TelegramConfig; TelegramNotifier(TelegramConfig.from_env()).send_error('systemd', 'penca-scheduler.service falló — chequear journalctl -u penca-scheduler')"
User=root
