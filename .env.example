# Copiar a `.env` y completar. NUNCA commitear .env (ya está en .gitignore).

# ============ LLM ============
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx

# ============ TELEGRAM ============
# Crear bot con @BotFather → /newbot → guardar token aquí.
# Para chat_id: enviar un mensaje al bot, después abrir https://api.telegram.org/bot<TOKEN>/getUpdates
# y copiar el "chat":{"id": ...}.
TELEGRAM_BOT_TOKEN=000000000:AAA-xxxxxxxxxxxxxxxxxxxxxxxx
TELEGRAM_CHAT_ID=000000000

# ============ DIGITAL OCEAN ============
# Generar en https://cloud.digitalocean.com/account/api/tokens con Full Access, 90 days.
DO_API_TOKEN=dop_v1_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ============ PENCA API (pendiente de admin) ============
PENCA_API_BASE_URL=https://penca-jmlm-2026.vercel.app/api/v1
PENCA_API_KEY=
PENCA_USERNAME=joacomarquez
PENCA_PASSWORD=
PENCA_IDS=id1,id2,id3,id4,id5,id6,id7,id8,id9,id10,id11,id12,id13,id14,id15   # IDs de tus pencas (N variable; el sistema asigna a cuantas pongas)

# ============ CASAS DE APUESTAS ============
# Pinnacle: las odds básicas suelen ser públicas; credenciales solo si las requieren para acceso a mercados.
PINNACLE_USER=
PINNACLE_PASS=

# Betfair: registrarse en developer.betfair.com, generar APP key.
BETFAIR_APP_KEY=
BETFAIR_USERNAME=
BETFAIR_PASSWORD=

# Bet365: nada de credenciales por ahora; Playwright opera anónimo.

# ============ TIPSTERS (opcionales / paywall) ============
THE_ATHLETIC_EMAIL=
THE_ATHLETIC_PASSWORD=

# ============ OPERACIÓN ============
# OJO: systemd (EnvironmentFile) NO recorta comentarios inline → estos valores van LIMPIOS,
# con el comentario en su propia línea. Un "DRY_RUN=true # ..." se leería como literal y rompería el parseo.
LOG_LEVEL=INFO
# Corremos todo en UTC; el display en las notifs es America/Montevideo.
TZ=UTC
# Datos: ./data es relativo a WorkingDirectory=/opt/penca → /opt/penca/data.
DATA_DIR=./data
# DRY_RUN=true → NO publica en la penca, solo notifica los picks.
DRY_RUN=true
